# Copy to .env. Do not commit .env.

# Private LAN OpenAI-compatible server (Tabby / vLLM / llama.cpp).
# Replace LLM_LAN_IP with the box that holds the chat model.
# Docker Desktop on macOS often cannot reach LAN IPs; use:
#   OPENAI_API_BASE_URL=http://host.docker.internal:8001/v1
OPENAI_API_BASE_URL=http://LLM_LAN_IP:8001/v1
OPENAI_API_KEY=sk-local-not-used
DEFAULT_MODELS=Qwen3.8-Flash-Next-Uncensored-exl3-4bpw

WEBUI_BIND=127.0.0.1
WEBUI_PORT=8080
WEBUI_NAME=Sara AI
WEBUI_URL=http://127.0.0.1:8080
CORS_ALLOW_ORIGIN=http://127.0.0.1:8080

# python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=replace-with-a-long-random-hex

ENABLE_SIGNUP=true
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Admin

JWT_EXPIRES_IN=7d
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SECURE=false

RAG_FILE_MAX_SIZE=8
RAG_FILE_MAX_COUNT=4
RAG_ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,webp

ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_PROMPT_GENERATION=true
IMAGE_GENERATION_ENGINE=comfyui
IMAGE_SIZE=1024x1024
IMAGE_STEPS=20
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=

CLOUDFLARE_TUNNEL_TOKEN=
TS_AUTHKEY=
TS_HOSTNAME=local-compute-node
